//! Grant authorization policy and durable replay state.

/// Required detached installation grants.
#[json(rename_all = "kebab-case")]
record GrantsConfig {
    /// Trusted grant-issuing roots. These authorize both system and app installation.
    roots: [string],
    /// Additional embedded publisher signature requirements.
    mode: GrantPolicy,
    /// Provisioned identity namespace, independent of the submitting caller.
    namespace: string,
    /// Absolute path to an executable that writes GrantIdentity JSON to stdout.
    /// Called during provisioning and before admission, reservation, and activation.
    /// Failure or invalid output rejects the operation.
    identity_helper: string,
    /// Assert that the system clock is trustworthy across power cycles.
    /// When false, all granted installations are rejected. This does not synchronize
    /// the clock; the platform must establish trusted time before enabling grants.
    trusted_system_clock: bool,
    /// Maximum total signed validity window (expiresAt - notBefore), in seconds.
    /// Defaults to 86400. Longer grants are rejected, even near their expiry.
    /// This limits permission lifetime, not installation duration.
    max_lifetime?: u64,
}

/// Signature requirements in addition to the mandatory detached grant.
variant GrantPolicy {
    /// Require a detached grant; embedded publisher signatures are optional.
    GrantOnly,
    /// Require both a detached grant and an independent embedded publisher signature.
    EmbeddedAndGrant,
}

/// Trusted facts supplied by the grant identity helper, independently of the request.
record GrantIdentity {
    /// Stable device identifier, for example derived from hardware or a trusted service.
    device: string,
    /// Current memberships within the configured namespace. Omission means no groups.
    /// A group-addressed grant matches if its exact group identifier appears here.
    /// Membership does not authorize additional groups or change certificate constraints.
    groups?: [string],
}

/// Durable installation authorization state. Missing or invalid state fails closed.
record GrantState {
    version: u32,
    /// Provisioned identity bound to this state.
    namespace: string,
    device: string,
    /// One sequence stream for system installations.
    system?: GrantTransaction,
    /// One sequence stream shared by application installations.
    apps?: GrantTransaction,
}

/// An admitted installation transaction.
record GrantTransaction {
    id: string,
    sequence: u64,
    /// Hash of authenticated grant fields, independent of JSON and certificate packaging.
    content_hash: string,
    /// Consumed before final activation, including interrupted activation attempts.
    consumed: bool,
}
