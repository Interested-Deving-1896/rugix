{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rugix_ctrl.config.Config",
  "type": "object",
  "description": "Rugix Ctrl configuration.",
  "properties": {
    "signatures": {
      "$ref": "#/$defs/rugix_ctrl.config.SignaturesConfig"
    },
    "grants": {
      "$ref": "#/$defs/rugix_ctrl.grants.GrantsConfig"
    },
    "compatibility": {
      "$ref": "#/$defs/rugix_ctrl.config.CompatibilityConfig"
    },
    "automatic-delta-updates": {
      "type": "boolean"
    }
  },
  "required": [],
  "unevaluatedProperties": false,
  "$defs": {
    "rugix_ctrl.config.CompatibilityConfig": {
      "$id": "rugix_ctrl.config.CompatibilityConfig",
      "type": "object",
      "properties": {
        "require-bundle-components": {
          "type": "boolean"
        }
      },
      "required": [],
      "unevaluatedProperties": false
    },
    "rugix_ctrl.config.SignaturesConfig": {
      "$id": "rugix_ctrl.config.SignaturesConfig",
      "type": "object",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "roots"
      ],
      "unevaluatedProperties": false
    },
    "rugix_ctrl.grants.GrantPolicy": {
      "$id": "rugix_ctrl.grants.GrantPolicy",
      "enum": [
        {
          "tag": "GrantOnly"
        },
        {
          "tag": "EmbeddedAndGrant"
        }
      ],
      "description": "Signature requirements in addition to the mandatory detached grant."
    },
    "rugix_ctrl.grants.GrantsConfig": {
      "$id": "rugix_ctrl.grants.GrantsConfig",
      "type": "object",
      "description": "Required detached installation grants.\n\nGrant and certificate validity assume a trustworthy system clock supplied by the platform.",
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mode": {
          "$ref": "#/$defs/rugix_ctrl.grants.GrantPolicy"
        },
        "namespace": {
          "type": "string"
        },
        "identity-helper": {
          "type": "string"
        },
        "max-lifetime": {
          "type": "integer",
          "format": "uint64"
        }
      },
      "required": [
        "roots",
        "mode",
        "namespace",
        "identity-helper"
      ],
      "unevaluatedProperties": false
    }
  }
}